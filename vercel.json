{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(img|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/portal",
      "destination": "https://bars.gobarzi.com",
      "permanent": false
    },
    {
      "source": "/portal/:path*",
      "destination": "https://bars.gobarzi.com",
      "permanent": false
    },
    {
      "source": "/download",
      "destination": "https://apps.apple.com/app/id6826678389",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "https://apps.apple.com/app/id6826678389",
      "permanent": false
    }
  ]
}
